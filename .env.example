DATABASE_URL=postgresql+psycopg://rag:rag@127.0.0.1:5433/rag
TEST_DATABASE_URL=postgresql+psycopg://rag:rag@127.0.0.1:5433/rag_test
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
# Celery broker (Redis). Worker on Windows: uv run celery -A app.celery_app worker --pool=solo -l info
CELERY_BROKER_URL=redis://127.0.0.1:6380/0
# DeepSeek API key for chat answers (platform.deepseek.com)
DEEPSEEK_API_KEY=
# Alibaba Cloud Model Studio (DashScope) API key for embeddings
DASHSCOPE_API_KEY=
# ---------- Docker deployment (only needed on the server) ----------
# Database password. Use only letters, digits, - and _. Generate with: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
# Set to 0.0.0.0 on the server so nginx is reachable from the internet (default: 127.0.0.1, this machine only)
NGINX_BIND=
